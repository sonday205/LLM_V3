RAG_APP_ENV=development
RAG_APP_HOST=0.0.0.0
RAG_APP_PORT=8005
RAG_LOG_LEVEL=INFO
RAG_LOG_FILE=logs/app.log
RAG_LOG_MAX_BYTES=10485760
RAG_LOG_BACKUP_COUNT=5
RAG_DEBUG_RESPONSE=true

DATABASE_URL=postgresql+psycopg://historical:historical@localhost:5433/historical_rag
POSTGRES_DB=historical_rag
POSTGRES_USER=historical
POSTGRES_PASSWORD=change-me

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
LLM_PROVIDER=gemini

# Speech-to-text push-to-talk qua OpenAI Realtime WebSocket.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime?intent=transcription

EMBEDDING_PROVIDER=bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
RETRIEVAL_LIMIT=6

MEMORY_TTL_SECONDS=604800
MEMORY_RECENT_TURNS=6
MEMORY_RELEVANT_TURNS=4

API_AUTH_ENABLED=false
APP_API_KEYS=
CORS_ORIGINS=http://127.0.0.1:8005,http://localhost:8005
